{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "skylight-wifi-automation values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "resources": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "commonAnnotations": { "type": "object" },
    "commonLabels": { "type": "object" },
    "hostAliases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ip", "hostnames"],
        "additionalProperties": false,
        "properties": {
          "ip": { "type": "string", "minLength": 1 },
          "hostnames": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "revisionHistoryLimit": { "type": "integer", "minimum": 0 },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "enableServiceLinks": { "type": "boolean" },
    "tmp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sizeLimit": { "type": "string", "minLength": 1 }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "configSource": { "type": "string", "enum": ["db", "file"] },
        "dataDir": { "type": "string", "minLength": 1 },
        "configPath": { "type": "string", "minLength": 1 },
        "uiPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "cookieSecure": { "type": "boolean" },
        "trustedProxies": { "type": "string" },
        "latchPath": { "type": "string" },
        "logLevel": { "type": "string", "minLength": 1 },
        "argon2Concurrency": { "type": "integer", "minimum": 1, "maximum": 32 }
      }
    },
    "extraEnv": { "type": "array" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "liveness": { "$ref": "#/definitions/probe" },
        "readiness": { "$ref": "#/definitions/probe" },
        "startup": { "$ref": "#/definitions/probe" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "nodePort": { "type": ["integer", "null"], "minimum": 30000, "maximum": 32767 },
        "externalTrafficPolicy": { "type": "string", "enum": ["", "Cluster", "Local"] },
        "annotations": { "type": "object" },
        "labels": { "type": "object" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annotations": { "type": "object" },
        "labels": { "type": "object" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["host", "paths"],
            "additionalProperties": false,
            "properties": {
              "host": { "type": "string", "minLength": 1 },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["path", "pathType"],
                  "additionalProperties": false,
                  "properties": {
                    "path": { "type": "string", "minLength": 1 },
                    "pathType": {
                      "type": "string",
                      "enum": ["Prefix", "Exact", "ImplementationSpecific"]
                    }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["secretName", "hosts"],
            "additionalProperties": false,
            "properties": {
              "secretName": { "type": "string", "minLength": 1 },
              "hosts": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessMode": {
          "type": "string",
          "enum": ["ReadWriteOnce", "ReadWriteOncePod", "ReadWriteMany"]
        },
        "size": { "type": "string", "minLength": 1 },
        "annotations": { "type": "object" }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timezone", "poll_seconds", "unifi_url", "unifi_tls_ca", "children"],
      "properties": {
        "timezone": { "type": "string", "minLength": 1 },
        "poll_seconds": { "type": "integer", "minimum": 30, "maximum": 3600 },
        "dry_run": { "type": "boolean" },
        "include_late": { "type": "boolean" },
        "include_routines": { "type": "boolean" },
        "empty_day_unlocks": { "type": "boolean" },
        "unifi_url": { "type": "string", "pattern": "^https://.+" },
        "unifi_site": { "type": "string" },
        "unifi_tls_ca": { "type": "string", "minLength": 1 },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "skylight_profile", "object_name", "cutoff"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "skylight_profile": { "type": "string", "minLength": 1 },
              "object_name": { "type": "string", "minLength": 1 },
              "cutoff": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "manual_unblock": { "type": "boolean" }
            }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "rolloutToken": { "type": "string" },
        "encryptionKey": { "type": "string" },
        "encryptionKeyNew": { "type": "string" },
        "setupToken": { "type": "string" },
        "skylightEmail": { "type": "string" },
        "skylightPassword": { "type": "string" },
        "unifiApiKey": { "type": "string" },
        "keys": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "encryption": { "type": "string", "minLength": 1 },
            "encryptionNew": { "type": "string", "minLength": 1 },
            "setupToken": { "type": "string", "minLength": 1 },
            "skylightEmail": { "type": "string", "minLength": 1 },
            "skylightPassword": { "type": "string", "minLength": 1 },
            "unifiApiKey": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "schedule": { "type": "string", "minLength": 1 },
        "timeZone": { "type": "string" },
        "retention": { "type": "integer", "minimum": 1 },
        "pinToAppNode": { "type": "boolean" },
        "suspend": { "type": "boolean" },
        "concurrencyPolicy": { "type": "string", "enum": ["Allow", "Forbid", "Replace"] },
        "successfulJobsHistoryLimit": { "type": "integer", "minimum": 0 },
        "failedJobsHistoryLimit": { "type": "integer", "minimum": 0 },
        "startingDeadlineSeconds": { "type": "integer", "minimum": 0 },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "ttlSecondsAfterFinished": { "type": "integer", "minimum": 0 },
        "affinity": { "type": "object" },
        "resources": { "type": "object" },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingClaim": { "type": "string" },
            "storageClass": { "type": "string" },
            "accessMode": {
              "type": "string",
              "enum": ["ReadWriteOnce", "ReadWriteOncePod", "ReadWriteMany"]
            },
            "size": { "type": "string", "minLength": 1 },
            "annotations": { "type": "object" }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "allowHelmTest": { "type": "boolean" },
        "probeCidrs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "ui": { "$ref": "#/definitions/peers" },
        "metrics": { "$ref": "#/definitions/peers" },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowAll": { "type": "boolean" },
            "rules": { "type": "array" }
          }
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string", "minLength": 1 },
        "scrapeTimeout": { "type": "string", "minLength": 1 },
        "labels": { "type": "object" },
        "annotations": { "type": "object" },
        "namespace": { "type": "string" },
        "scheme": { "type": "string", "enum": ["http", "https"] },
        "path": { "type": "string", "minLength": 1 },
        "tlsConfig": { "type": "object" },
        "relabelings": { "type": "array" },
        "metricRelabelings": { "type": "array" },
        "honorLabels": { "type": "boolean" }
      }
    }
  },
  "definitions": {
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 },
        "successThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "peers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cidrs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "namespaceSelectors": { "type": "array" },
        "podSelectors": { "type": "array" }
      }
    }
  }
}
